{
  "name": "zell-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "release": "node scripts/fetch-release.mjs",
    "predev": "npm run release && npm run stdlib",
    "dev": "vite",
    "prebuild": "npm run release && npm run stdlib",
    "build": "tsc --noEmit && vite build && node scripts/routes.mjs",
    "deploy": "node scripts/publish.mjs",
    "preview": "vite preview",
    "php": "php -S localhost:8000 -t public",
    "stdlib": "node scripts/gen-stdlib.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@types/mdx": "^2.0.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "basic-ftp": "^5.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
