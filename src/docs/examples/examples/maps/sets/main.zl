namespace sets

import io

func main() {
    // map[T]bool works as a set.
    var seen = map[string]bool{}
    var unique []string
    for tag in ["go", "zell", "go", "c", "zell"] {
        if !seen[tag] {
            seen[tag] = true
            unique = append(unique, tag)
        }
    }
    println(unique, len(seen))

    var a = map[int]bool{1: true, 2: true, 3: true}
    var b = map[int]bool{2: true, 3: true, 4: true}

    var both []int
    for k in maps.SortedKeys(a) {
        if b[k] {
            both = append(both, k)
        }
    }
    println("intersection:", both)

    var union = maps.Merge(a, b)
    println("union:", maps.SortedKeys(union))
}
