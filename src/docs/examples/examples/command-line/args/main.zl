namespace greet

import io

func main() {
    // os.Args()[0] is the program itself; the arguments follow.
    var args = os.Args()[1..]
    if len(args) == 0 {
        println("usage: greet NAME...")
        return
    }
    for i, name in args {
        println(fmt.Format("{0}. hello, {1}", i + 1, name))
    }
}
