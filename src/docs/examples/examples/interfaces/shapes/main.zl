namespace shapes

import io
import math

interface Shape {
    func Area() float
    func Name() string
}

struct Rect {
    W float
    H float

    func Area() float { return this.W * this.H }
    func Name() string { return "rect" }
}

struct Circle {
    R float

    func Area() float { return math.Pi * this.R * this.R }
    func Name() string { return "circle" }
}

func main() {
    // A slice of an interface holds values of different types.
    var shapes []Shape = [Rect{W: 3.0, H: 4.0}, Circle{R: 1.0}, Rect{W: 1.0, H: 1.0}]
    var total = 0.0
    for s in shapes {
        println(s.Name(), fmt.Sprintf("%.2f", s.Area()))
        total += s.Area()
    }
    println("total:", fmt.Sprintf("%.2f", total))
}
