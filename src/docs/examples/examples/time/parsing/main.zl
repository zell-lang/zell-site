namespace parsing

import io

func main() {
    var inputs = ["2026-10-30T14:00:00Z", "2026-10-30T14:00:00+03:00", "30 Oct 2026", "2026-13-01T00:00:00Z"]
    for s in inputs {
        var t = try time.ParseTime(time.RFC3339, s) catch err {
            println("error:", err)
            continue
        }
        // UTC() converts to UTC before printing.
        println(t.UTC().Format(time.DateTime))
    }

    // A custom layout.
    var d = try time.ParseTime("02 Jan 2006", "30 Oct 2026") else time.Unix(0, 0)
    println(d.Format(time.DateOnly), d.WeekdayName())
}
