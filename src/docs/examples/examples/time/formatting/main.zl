namespace formatting

import io

func main() {
    var t = time.Date(2026, 7, 4, 9, 5, 7, 123000000, nil)

    // Layouts use Go's reference time: Mon Jan 2 15:04:05 2006.
    println(t.Format(time.RFC3339))
    println(t.Format(time.DateTime))
    println(t.Format(time.Kitchen))
    println(t.Format("Monday, 2 January 2006"))
    println(t.Format("02/01/06 15:04:05.000"))
    println(t.Format(time.RFC1123))

    // Strftime for C-style formats.
    println(t.Strftime("%Y-%m-%d %H:%M"))
}
