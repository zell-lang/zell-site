namespace gcoll

import collections
import io

func main() {
    // Generic containers from the standard library.
    var list = collections.List<string>{}
    list.Add("b")
    list.Add("a")
    list.Insert(0, "z")
    println(list.Len(), list.Get(0), list.Items())

    // Set and Map keep insertion order when iterated.
    var seen = collections.Set<int>{}
    for n in [3, 1, 3, 2, 1] {
        seen.Add(n)
    }
    println(seen.Items(), seen.Has(2), seen.Has(7))

    var ages = collections.Map<string, int>{}
    ages.Set("zoe", 30)
    ages.Set("adam", 41)
    for k, v in ages {
        println(k, v)
    }

    var q = collections.Queue<string>{}
    q.Push("first")
    q.Push("second")
    println(try q.Pop() else "", q.Len())
}
