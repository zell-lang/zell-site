namespace gshapes

import io

interface Shape {
    func Area() float
}

struct Square {
    Side float
    func Area() float { return this.Side * this.Side }
}

struct Tri {
    Base   float
    Height float
    func Area() float { return this.Base * this.Height / 2.0 }
}

// An interface as a constraint: compiled once per type, with direct calls.
func totalArea<T: Shape>(shapes []T) float {
    var sum = 0.0
    for s in shapes {
        sum += s.Area()
    }
    return sum
}

// Add accepts any type with +: numbers, strings, structs with an Add method.
func sum<T: Add>(xs []T, zero T) T {
    var acc = zero
    for x in xs {
        acc = acc + x
    }
    return acc
}

func main() {
    println(totalArea([Square{Side: 2.0}, Square{Side: 3.0}]))
    println(totalArea([Tri{Base: 4.0, Height: 1.0}]))
    println(sum([1, 2, 3], 0), sum([0.5, 0.25], 0.0), sum(["a", "b", "c"], ""))
}
