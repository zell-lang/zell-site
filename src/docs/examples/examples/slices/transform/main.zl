namespace transform

import io

func main() {
    var nums = [1, 2, 3, 4, 5, 6]

    var squares = slices.Map(nums, (n int) => n * n)
    var even = slices.Filter(nums, (n int) => n % 2 == 0)
    var total = slices.Reduce(nums, 0, (acc int, n int) => acc + n)
    println(squares, even, total)

    var labels = slices.Map(nums, (n int) => fmt.Format("#{0}", n))
    println(strings.Join(labels, " "))

    println(slices.All(nums, (n int) => n > 0), slices.Count(nums, (n int) => n > 4))

    // Remove duplicates, keeping the first occurrence.
    println(slices.Unique([3, 1, 3, 2, 1]))

    // Split into chunks of at most n elements.
    println(slices.Chunk(nums, 4))
}
