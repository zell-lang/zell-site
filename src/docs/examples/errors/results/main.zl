namespace temps

import io

// `float!` is a float or an error.
func celsius(fahrenheit float) float! {
    if fahrenheit < -459.67 {
        return error("below absolute zero")
    }
    return (fahrenheit - 32.0) * 5.0 / 9.0
}

func main() {
    println(try celsius(212.0) else 0.0)
    println(try celsius(-500.0) else 0.0)
}
