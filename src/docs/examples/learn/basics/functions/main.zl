namespace geometry

import io

// Parameters of the same type can share it, as in Go.
func area(w, h int) int {
    return w * h
}

// Several results form a tuple.
func divmod(a, b int) (int, int) {
    return (a / b, a % b)
}

func describe(name string, sides int) {   // no result: void is omitted
    println(name, "has", sides, "sides")
}

func main() {
    println(area(3, 4))
    describe("triangle", 3)

    var q, r = divmod(17, 5)      // destructure into new variables
    println(q, r)

    q, r = r, q                   // assign several at once
    println(q, r)

    var (_, rest) = divmod(9, 4)  // _ drops a result
    println(rest)

    var pair = divmod(7, 2)       // or keep the tuple whole
    println(pair, pair.0, pair.1)
}
